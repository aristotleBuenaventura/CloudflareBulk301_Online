# Cloudflare API token — Worker only (never commit real values).
# Least privilege: Zone → Zone (Read), Page Rules (Edit), Single Redirect (Edit).
CLOUDFLARE_API_TOKEN=

# Optional second Cloudflare account token (Account 2 domain list in the UI).
CLOUDFLARE_API_TOKEN_2=

# Bootstrap / create-user gate (NOT daily login). Use 16+ random chars for public.
ADMIN_SECRET=change-me-to-a-long-random-string

# Public UI URL used in password-reset emails + Telegram viewer link.
APP_URL=http://localhost:5173

# Public read-only viewer (/viewer?t=...). Use a long random value (24+ chars).
VIEWER_TOKEN=

# Telegram notify after apply (Sample A). Leave empty to disable.
# Create bot via @BotFather, add to group, use group chat_id (often -100…).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail SMTP for forgot-password emails (same pattern as MR Database Tool).
# Use a Google App Password for SMTP_PASS — not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=aris@casinomcw.com
SMTP_PASS=
SMTP_FROM=Bulk301 <aris@casinomcw.com>

# Local: leave PUBLIC_INTERNET unset/false so Vite proxy works without ALLOWED_ORIGINS.
# PUBLIC_INTERNET=false
# IP_ALLOWLIST=
# ALLOWED_ORIGINS=
